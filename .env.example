# Copy to .env on the VPS. Never commit real secrets.

# Process binds 0.0.0.0:$PORT (default 3000).
PORT=3000

NODE_ENV=production

# Required when NODE_ENV=production. Persist this path on a volume.
HIREAPI_DATABASE=/app/data/hireapi.sqlite

# Optional first key when the keys table is empty. hk_live_... or hk_test_...
# HIREAPI_BOOTSTRAP_KEY=hk_live_replace_me

# Off by default. Set to 1 (or true/yes/on) to GET public Greenhouse, Ashby, or Lever URLs.
# Leave unset or 0 in CI. LinkedIn and Indeed are not enabled.
HIREAPI_LIVE_ATS=0
